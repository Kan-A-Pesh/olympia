/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2711";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			olympia_keys: olympia-keys {
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&olympia_keys_pins>;
				status = "okay";

				key-nw {
					label = "olympia:pad-nw";
					linux,code = <71>;
					gpios = <&gpio 11 1>;
					debounce-interval = <20>;
					autorepeat;
				};
				key-n {
					label = "olympia:pad-n";
					linux,code = <72>;
					gpios = <&gpio 12 1>;
					debounce-interval = <20>;
					autorepeat;
				};
				key-ne {
					label = "olympia:pad-ne";
					linux,code = <73>;
					gpios = <&gpio 18 1>;
					debounce-interval = <20>;
					autorepeat;
				};
				key-w {
					label = "olympia:pad-w";
					linux,code = <75>;
					gpios = <&gpio 8 1>;
					debounce-interval = <20>;
					autorepeat;
				};
				key-e {
					label = "olympia:pad-e";
					linux,code = <77>;
					gpios = <&gpio 20 1>;
					debounce-interval = <20>;
					autorepeat;
				};
				key-sw {
					label = "olympia:pad-sw";
					linux,code = <79>;
					gpios = <&gpio 7 1>;
					debounce-interval = <20>;
					autorepeat;
				};
				key-s {
					label = "olympia:pad-s";
					linux,code = <80>;
					gpios = <&gpio 25 1>;
					debounce-interval = <20>;
					autorepeat;
				};
				key-se {
					label = "olympia:pad-se";
					linux,code = <81>;
					gpios = <&gpio 21 1>;
					debounce-interval = <20>;
					autorepeat;
				};

				key-enc1 {
					label = "olympia:enc1-push";
					linux,code = <183>;
					gpios = <&gpio 27 1>;
					debounce-interval = <20>;
				};
				key-enc2 {
					label = "olympia:enc2-push";
					linux,code = <184>;
					gpios = <&gpio 22 1>;
					debounce-interval = <20>;
				};
				key-enc3 {
					label = "olympia:enc3-push";
					linux,code = <185>;
					gpios = <&gpio 23 1>;
					debounce-interval = <20>;
				};
				key-enc4 {
					label = "olympia:enc4-push";
					linux,code = <186>;
					gpios = <&gpio 24 1>;
					debounce-interval = <20>;
				};
			};
		};
	};

	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			olympia_keys_pins: olympia_keys_pins {
				brcm,pins = <11 12 18 8 20 7 25 21 27 22 23 24>;
				brcm,function = <0>;
				brcm,pull = <2>;
			};
		};
	};
};
